generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id       String @id @default(uuid())
  username String @unique
  email    String @unique
  role     Role   @default(USER)

  password String
  avatar   String?

  streams  Stream?
  messages Message[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("accounts")
}

model Message {
  id   String  @id @default(uuid())
  text String?

  stream   Stream @relation(fields: [streamId], references: [id])
  streamId String

  account   Account? @relation(fields: [accountId], references: [id])
  accountId String?

  createdAt DateTime @default(now()) @map("created_at")

  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  @@index([streamId, accountId])
  @@map("messages")
}

model Stream {
  id String @id @default(uuid())

  title String

  account   Account @relation(fields: [accountId], references: [id])
  accountId String  @unique

  messages  Message[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  streamBanLists StreamBanList[]

  @@map("streams")
}

model StreamBanList {
  id String @id @default(uuid())

  streamId String
  stream   Stream @relation(fields: [streamId], references: [id])
  userId   String

  bannedBy String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([streamId, userId])
  @@map("stream_ban_list")
}

enum Role {
  USER
  STREAMER
  ADMIN
}
